{
  "name": "bwh-auth",
  "version": "0.6.4",
  "description": "Shared React auth UI and browser WebAuthn helpers for BWH applications.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bherila/auth-react.git"
  },
  "bugs": {
    "url": "https://github.com/bherila/auth-react/issues"
  },
  "homepage": "https://github.com/bherila/auth-react#readme",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "scripts/spotlight-noindex.mjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --dts-resolve --tsconfig tsconfig.build.json",
    "release": "node scripts/release.mjs",
    "test": "vitest run",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "prepare": "pnpm run build",
    "postinstall": "node scripts/spotlight-noindex.mjs",
    "verify-package": "node scripts/verify-package.mjs"
  },
  "peerDependencies": {
    "lucide-react": ">=0.468.0 <2.0.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "esbuild": "0.28.2",
    "jsdom": "^31.0.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "spotlight-noindex": "1.1.1",
    "tsup": "^9.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  }
}
