{
  "name": "bwh-auth",
  "version": "0.3.1",
  "description": "Shared React auth UI and browser WebAuthn helpers for BWH applications.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bherila/auth-react.git"
  },
  "bugs": {
    "url": "https://github.com/bherila/auth-react/issues"
  },
  "homepage": "https://github.com/bherila/auth-react#readme",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "scripts/spotlight-noindex.mjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --dts-resolve",
    "release": "node scripts/release.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "pnpm run build",
    "postinstall": "node scripts/spotlight-noindex.mjs"
  },
  "peerDependencies": {
    "lucide-react": ">=0.468.0 <2.0.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "esbuild": "0.28.2",
    "jsdom": "^27.4.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "spotlight-noindex": "1.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
